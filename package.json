{
  "name": "playui",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source React prototyping playground with an OpenAI-compatible AI assistant.",
  "homepage": "https://playui.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sashachabin/playui.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,ai -c cyan,magenta \"vite\" \"npm:server\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "server": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test server/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@skbkontur/colors": "^3.0.0",
    "@skbkontur/react-ui": "^6.5.7",
    "antd": "^6.7.2",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "lucide-react": "^1.79.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.7",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.34.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
